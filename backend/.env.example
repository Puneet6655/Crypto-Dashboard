# Copy this file to backend/.env and fill in the values. The API reads backend/.env
# when it starts; real environment variables ($env:NAME) win over the file.
BTC_PROVIDER_BASE_URL=https://mempool.space/api
BTC_NETWORK=mainnet
HTTP_TIMEOUT_SECONDS=10
# Bitcoin data sources in the order they are tried. When one is rate limited (HTTP 429) or down,
# the next answers and the first cools down (30 s, doubling to 10 min). No keys needed.
BTC_PROVIDERS=mempool,blockstream
# Backup Esplora API. For testnet use https://blockstream.info/testnet/api (and mempool's /testnet/api).
BTC_ESPLORA_BASE_URL=https://blockstream.info/api
# OFAC and Ransomwhere address lists: where they are saved, and whether the API downloads
# missing or day-old lists by itself (checked hourly). On a read-only host use e.g. /tmp/indicators.
INDICATORS_DIR=
INDICATORS_AUTO_REFRESH=true
INDICATORS_MAX_AGE_HOURS=24
# Ethereum lookups (Etherscan API V2, free key from https://etherscan.io/myapikey). Leave empty to switch
# Ethereum off. Keep the real key only in backend/.env, which is gitignored.
ETHERSCAN_API_KEY=
# Blockscout PRO API (free key from https://dev.blockscout.com): Ethereum backup after Etherscan, before Alchemy.
# Server-side only, never in the frontend. Its free plan has no Base, Polygon or zkSync, so Base stays on Alchemy.
BLOCKSCOUT_API_KEY=
# Alchemy (https://dashboard.alchemy.com): backup for Ethereum and the source for Base. Paste the key, or the
# endpoint (https://eth-mainnet.g.alchemy.com/v2/<key>), or both. Enable Base for the app in Alchemy's dashboard.
ALCHEMY_API_KEY=
ALCHEMY_ENDPOINT=
# Alchemy stays off until this is true (Ethereum backup and Base lookups).
ALCHEMY_ENABLED=false
# Day of the month your Alchemy plan's compute units reset (see the Alchemy dashboard). Used by the API usage panel.
ALCHEMY_BILLING_DAY=1
# Live alerts (WebSocket to Alchemy) for addresses in open cases and on the OFAC list. Needs ALCHEMY_ENABLED=true.
LIVE_ALERTS_ENABLED=true
LIVE_ALERTS_WATCH_OFAC=true
# One or more browser origins allowed to call the API, comma-separated.
FRONTEND_ORIGIN=http://localhost:5173
# Node cap for Investigate graphs (Expand node can add more, up to 1,500 in the browser).
MAX_GRAPH_NODES=250
# Neon Postgres connection string. Leave empty to run without saving data.
# Get it with: npx neonctl connection-string --pooled
DATABASE_URL=
# Training scripts only: path to the Google Cloud service-account key for BigQuery.
# Optional when the key is the only .json file in backend/data/ (that folder's *.json is gitignored).
BQ_KEY_PATH=
# Sign-in. Every page needs an account; new sign-ups are viewers. Create the first admin with:
#   python -m app.auth create-admin you@example.com
# AUTH_REQUIRED=false lets anyone view without signing in (local work without a database only).
AUTH_REQUIRED=true
# Set to false to stop new sign-ups (admins can still create accounts from the command line).
SIGNUP_ENABLED=true
# How long a sign-in lasts, in hours (168 = 7 days).
SESSION_HOURS=168

# Legal pages (#/privacy, #/terms). The text is a template, not legal advice: fill these in and have it checked
# before opening sign-up to the public. See backend/app/legal.py.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
# Retention: audit log rows older than this are deleted; accounts with no sign-in this long are deleted (0 = off).
AUDIT_RETENTION_DAYS=365
INACTIVE_ACCOUNT_DAYS=730

# Graph explorer (advanced graph mode): its own daily share of the Alchemy free plan (30M CU a month),
# and the largest node cap the browser may ask for.
GRAPH_ALCHEMY_DAILY_CU=300000
GRAPH_MAX_NODES=20000

# How much history one lookup reads (Investigate and Graph explorer). Every call already asks for the
# provider's biggest page; these say how many pages to follow when a page comes back full.
# Bitcoin (mempool.space / Blockstream): 25 txs per page, fixed by the server. 4 pages = about 100 txs.
BTC_ADDRESS_PAGES=4
# Ethereum/Base: Etherscan/Blockscout 1,000 rows per page (10 pages at most); Alchemy 1,000 per call via
# pageKey (120 CU per call). 3 = up to 3,000 rows per list.
EVM_LIST_PAGES=3
# Solana: getTransaction reads one transaction per call (40 CU, about 6 a second on the free plan).
SOLANA_TX_DETAIL_LIMIT=60
GRAPH_SOLANA_TXS=25

# Dune API key: downloads exchange labels (cex.addresses) once a week for the Graph explorer.
# Free plan: 2,500 credits a month; the weekly query uses a few. See README (licence: BSL 1.1).
DUNE_API_KEY=

# --- x402 payments (app/x402) ---
# The monitor follows LIVE_ALERTS_ENABLED unless set here. It watches the riskiest x402 servers through Blockscout
# (BLOCKSCOUT_API_KEY if set, else the free public explorer), with Alchemy as backup.
# X402_MONITOR_ENABLED=true
# X402_WATCH_COUNT=10
# X402_WATCH_EXTRA=0x...,0x...
# X402_ALERT_MIN_SEVERITY=medium
# Coinbase CDP SQL API: with a free key (portal.cdp.coinbase.com > API Keys > Secret API key) the monitor checks
# every x402 payment on Base once a minute, not just the watchlist.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Helius (free key from dashboard.helius.dev): only for the research script training/x402_records_solana.py,
# which pulls real Solana x402 payments for rule testing. The live site does not use it.
# HELIUS_API_KEY=

# Authority red flags (rule packs in backend/rule_packs; see app/redflags)
# Extra folder of pack files (*.yaml) loaded next to the built-in ones, e.g. a mounted volume:
# RULE_PACKS_DIR=
# Pack ids switched off by default (comma separated), e.g. on a server whose disk resets on deploy:
# RED_FLAG_PACKS_DISABLED=

# AI analyst (Milestone 14): a local model in Ollama (https://ollama.com). Nothing goes to an outside AI service.
# Install Ollama, then: ollama pull qwen3:8b
ANALYST_ENABLED=true
OLLAMA_URL=http://localhost:11434
ANALYST_MODEL=qwen3:8b
# 10240 keeps qwen3:8b almost all on an 8 GB GPU (16384 spills to the CPU and is ~3x slower).
# ANALYST_THINK=true was much slower with no accuracy gain in the 2026-11-24 test.
ANALYST_NUM_CTX=10240
ANALYST_THINK=false
# Longest answer in tokens. The facts (~6-7k tokens), one lookup and the answer must fit in ANALYST_NUM_CTX.
ANALYST_MAX_ANSWER_TOKENS=800
# Optional: answer with Claude through the Claude Code CLI on this computer instead (the AI Analyst tab can also
# switch per question). This SENDS THE CASE FACTS TO ANTHROPIC. Needs `claude` installed and signed in (/login).
# ANALYST_PROVIDER=ollama
# ANALYST_CLAUDE_COMMAND=claude
# ANALYST_CLAUDE_MODEL=sonnet
# ANALYST_CLAUDE_TIMEOUT_SECONDS=300
