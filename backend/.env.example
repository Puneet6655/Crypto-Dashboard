# Copy this file to backend/.env and fill in the values. The API reads backend/.env
# when it starts; real environment variables ($env:NAME) win over the file.
BTC_PROVIDER_BASE_URL=https://mempool.space/api
BTC_NETWORK=mainnet
HTTP_TIMEOUT_SECONDS=10
# Bitcoin data sources in the order they are tried. When one is rate limited (HTTP 429) or down,
# the next answers and the first cools down (30 s, doubling to 10 min). No keys needed.
BTC_PROVIDERS=mempool,blockstream
# Backup Esplora API. For testnet use https://blockstream.info/testnet/api (and mempool's /testnet/api).
BTC_ESPLORA_BASE_URL=https://blockstream.info/api
# OFAC and Ransomwhere address lists: where they are saved, and whether the API downloads
# missing or day-old lists by itself (checked hourly). On a read-only host use e.g. /tmp/indicators.
INDICATORS_DIR=
INDICATORS_AUTO_REFRESH=true
INDICATORS_MAX_AGE_HOURS=24
# Ethereum lookups (Etherscan API V2, free key from https://etherscan.io/myapikey). Leave empty to switch
# Ethereum off. Keep the real key only in backend/.env, which is gitignored.
ETHERSCAN_API_KEY=
# Alchemy (https://dashboard.alchemy.com): backup for Ethereum and the source for Base. Paste the key, or the
# endpoint (https://eth-mainnet.g.alchemy.com/v2/<key>), or both. Enable Base for the app in Alchemy's dashboard.
ALCHEMY_API_KEY=
ALCHEMY_ENDPOINT=
# Alchemy stays off until this is true (Ethereum backup and Base lookups).
ALCHEMY_ENABLED=false
# Live alerts (WebSocket to Alchemy) for addresses in open cases and on the OFAC list. Needs ALCHEMY_ENABLED=true.
LIVE_ALERTS_ENABLED=true
LIVE_ALERTS_WATCH_OFAC=true
# One or more browser origins allowed to call the API, comma-separated.
FRONTEND_ORIGIN=http://localhost:5173
MAX_GRAPH_NODES=50
# Neon Postgres connection string. Leave empty to run without saving data.
# Get it with: npx neonctl connection-string --pooled
DATABASE_URL=
# Training scripts only: path to the Google Cloud service-account key for BigQuery.
# Optional when the key is the only .json file in backend/data/ (that folder's *.json is gitignored).
BQ_KEY_PATH=
# Sign-in. Every page needs an account; new sign-ups are viewers. Create the first admin with:
#   python -m app.auth create-admin you@example.com
# AUTH_REQUIRED=false lets anyone view without signing in (local work without a database only).
AUTH_REQUIRED=true
# Set to false to stop new sign-ups (admins can still create accounts from the command line).
SIGNUP_ENABLED=true
# How long a sign-in lasts, in hours (168 = 7 days).
SESSION_HOURS=168

# Graph explorer (advanced graph mode): its own daily share of the Alchemy free plan (30M CU a month),
# and the largest node cap the browser may ask for.
GRAPH_ALCHEMY_DAILY_CU=300000
GRAPH_MAX_NODES=20000
